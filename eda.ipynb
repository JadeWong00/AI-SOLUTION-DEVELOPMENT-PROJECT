   "source": [
    "import pandas as pd\n",
    "import sqlite3\n",
    "\n",
    "conn = sqlite3.connect('bmarket.db') \n",
    "\n",
    "sql_query = \"SELECT * FROM bank_marketing\"\n",
    "\n",
    "df = pd.read_sql(sql_query, conn)\n",
    "\n",
    "conn.close()\n",
    "\n",
    "df.head()\n"
   ]
